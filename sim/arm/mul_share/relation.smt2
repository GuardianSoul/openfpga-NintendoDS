; All 128 operand/accumulator bits and all long/signed/accumulate choices.
; No assumptions or finite sample set. UNSAT proves full low64 equivalence.
(set-logic QF_BV)
(declare-fun a () (_ BitVec 32))
(declare-fun b () (_ BitVec 32))
(declare-fun lo () (_ BitVec 32))
(declare-fun hi () (_ BitVec 32))
(declare-fun long () Bool)
(declare-fun sign () Bool)
(declare-fun accum () Bool)
(define-fun signed-long () Bool (and long sign))
(define-fun old-p () (_ BitVec 64)
 (ite signed-long
  (bvmul ((_ sign_extend 32) a) ((_ sign_extend 32) b))
  (bvmul ((_ zero_extend 32) a) ((_ zero_extend 32) b))))
(define-fun ma () (_ BitVec 33)
 (concat (ite signed-long ((_ extract 31 31) a) #b0) a))
(define-fun mb () (_ BitVec 33)
 (concat (ite signed-long ((_ extract 31 31) b) #b0) b))
(define-fun new-p () (_ BitVec 66)
 (bvmul ((_ sign_extend 33) ma) ((_ sign_extend 33) mb)))
(define-fun addend () (_ BitVec 64)
 (ite accum (ite long (concat hi lo) (concat #x00000000 lo)) #x0000000000000000))
(assert (distinct (bvadd old-p addend)
                  (bvadd ((_ extract 63 0) new-p) addend)))
(check-sat)
