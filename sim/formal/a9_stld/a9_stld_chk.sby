[tasks]
cover
mutant

[options]
cover: mode cover
cover: depth 40
mutant: mode bmc
mutant: depth 30

[engines]
smtbmc yices

[script]
plugin -i slang
cover: read_slang -D FORMAL -D SYNTHESIS -D FV_COVER --allow-use-before-declare --top fv_a9_stld arm_pkg.sv arm_thumb.sv arm9_core.sv fv_a9_stld.sv
mutant: read_slang -D FORMAL -D SYNTHESIS --allow-use-before-declare --top fv_a9_stld arm_pkg.sv arm_thumb.sv arm9_core_mut.sv fv_a9_stld.sv
prep -top fv_a9_stld
memory_map
opt -fast

[files]
../../../rtl/arm/arm_pkg.sv
../../../rtl/arm/arm_thumb.sv
../../../rtl/arm/arm9_core.sv
arm9_core_mut.sv
fv_a9_stld.sv
