// Sidecar v1 is extra source evidence, not a broader canonical-context ABI.
// Root must retain the existing host capture/schema/source qualification.
task automatic import_gx_context_with_clip_witness(
 input logic[31:0]context_data[0:2631],
 input logic[31:0]words[0:4][0:31],outside_q[0:4],inside_q[0:4],
 input logic[31:0]valid_groups,input logic[4:0]valid_reads,
 input bit held,post_m,clean_scope_validated);
 logic[85:0]saved_metadata;time deposit_time;
 assert(clean_scope_validated && !clip_store_bridge_active)
  else $fatal(1,"CLIP_IMPORT_SCOPE_OR_REENTRY");
 clip_import_preflight(words,outside_q,inside_q,valid_groups,valid_reads,held,post_m);
 // Exact existing2632word schema: reject disagreeing canonical replicas.
 for(int g=0;g<4;g++)begin
  assert(context_data[1492+g]===context_data[1496+g] && context_data[1492+g]===words[0][g] && context_data[363+16*g]===words[0][g])else $fatal(1,"CLIP_IMPORT_CANONICAL_CONFLICT field0");
  assert(context_data[1500+g]===context_data[1504+g] && context_data[1500+g]===words[1][g] && context_data[364+16*g]===words[1][g])else $fatal(1,"CLIP_IMPORT_CANONICAL_CONFLICT field1");
  assert(context_data[1508+g]===context_data[1512+g] && context_data[1508+g]===words[2][g] && context_data[365+16*g]===words[2][g])else $fatal(1,"CLIP_IMPORT_CANONICAL_CONFLICT field2");
  assert(context_data[1516+g]===context_data[1520+g] && context_data[1516+g]===words[3][g] && context_data[367+16*g]===words[3][g])else $fatal(1,"CLIP_IMPORT_CANONICAL_CONFLICT field3");
  assert(context_data[1524+g]===context_data[1528+g] && context_data[1524+g]===words[4][g] && context_data[368+16*g]===words[4][g])else $fatal(1,"CLIP_IMPORT_CANONICAL_CONFLICT field4");
 end
 saved_metadata=clip_import_metadata();deposit_time=$time;
 clip_store_bridge_active=1'b1;
 import_gx_context(context_data,held);
 clip_import_words(words,outside_q,inside_q);
 verify_gx_context(context_data);
 clip_verify_words(words,outside_q,inside_q);
 assert(clip_import_metadata()===saved_metadata && $time==deposit_time)
  else $fatal(1,"CLIP_IMPORT_METADATA_OR_TIME_CHANGED");
 clip_store_bridge_active=1'b0;
endtask

// Produces actual default-source backing/read values, never invented fields.
// Parent atomic/capture/profile binding and scheduler certification remain
// the enclosing consumer's review/proof obligation.
task automatic capture_gx_context_clip_witness(
 output logic[31:0]words[0:4][0:31],outside_q[0:4],inside_q[0:4],
 input bit held,post_m,last_sys_write_absent,clean_scope_validated);
 assert(clean_scope_validated)else $fatal(1,"CLIP_IMPORT_SCOPE_OR_REENTRY");
 clip_capture_legacy_witness(words,outside_q,inside_q,held,post_m,last_sys_write_absent);
 for(int g=0;g<32;g++)assert(words[0][g]===`RUNTIME_GEOMETRY.u_eng.u_rfa.mem[11'h200+16*g+4] && words[0][g]===`RUNTIME_GEOMETRY.u_eng.u_rfb.mem[11'h200+16*g+4])else $fatal(1,"CLIP_CAPTURE_RF_CONFLICT field0");
 for(int g=0;g<32;g++)assert(words[1][g]===`RUNTIME_GEOMETRY.u_eng.u_rfa.mem[11'h200+16*g+5] && words[1][g]===`RUNTIME_GEOMETRY.u_eng.u_rfb.mem[11'h200+16*g+5])else $fatal(1,"CLIP_CAPTURE_RF_CONFLICT field1");
 for(int g=0;g<32;g++)assert(words[2][g]===`RUNTIME_GEOMETRY.u_eng.u_rfa.mem[11'h200+16*g+6] && words[2][g]===`RUNTIME_GEOMETRY.u_eng.u_rfb.mem[11'h200+16*g+6])else $fatal(1,"CLIP_CAPTURE_RF_CONFLICT field2");
 for(int g=0;g<32;g++)assert(words[3][g]===`RUNTIME_GEOMETRY.u_eng.u_rfa.mem[11'h200+16*g+8] && words[3][g]===`RUNTIME_GEOMETRY.u_eng.u_rfb.mem[11'h200+16*g+8])else $fatal(1,"CLIP_CAPTURE_RF_CONFLICT field3");
 for(int g=0;g<32;g++)assert(words[4][g]===`RUNTIME_GEOMETRY.u_eng.u_rfa.mem[11'h200+16*g+9] && words[4][g]===`RUNTIME_GEOMETRY.u_eng.u_rfb.mem[11'h200+16*g+9])else $fatal(1,"CLIP_CAPTURE_RF_CONFLICT field4");
endtask
